module bin_to_thermo #(
    parameter DIN_WIDTH = 8
) (
    input logic [DIN_WIDTH-1:0] din,
    output logic [2**DIN_WIDTH-1:0] dout
);
  always_comb begin
    int i;
    for (i = 0; i < 2**DIN_WIDTH; i = i + 1) begin
      if (i < din) begin 
        dout[i] = 1'b1;
      end else begin 
        dout[i] = 1'b0; 
      end
    end
  end
endmodule
